{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "allowJs": true,
    "checkJs": true,

    "declaration": true,
    "emitDeclarationOnly": true,

    "rootDir": "./src",

    "skipLibCheck": true,

    "noImplicitThis": true,
    "noImplicitOverride": true,

    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*.js", "src/**/*.d.ts"]
}
